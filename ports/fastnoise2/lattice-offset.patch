diff --git a/include/FastNoise/Generators/Perlin.h b/include/FastNoise/Generators/Perlin.h
index d6a3526..09a1bca 100644
--- a/include/FastNoise/Generators/Perlin.h
+++ b/include/FastNoise/Generators/Perlin.h
@@ -7,6 +7,25 @@ namespace FastNoise
     {
     public:
         const Metadata& GetMetadata() const override;
+
+        /** @brief Shift the integer lattice the 3D hash sees, in cells at this node's frequency.
+         *
+         *  Added to each floored coordinate before it is multiplied by its prime, with
+         *  wrapping int32 arithmetic, so noise at position p with offset o equals noise at
+         *  p + o exactly while the float interpolation only ever sees p. Lets a caller
+         *  split a large f64 position into an integer part and a small float part.
+         *  Not serialised, and not part of the node graph: set it per evaluation, and
+         *  give each thread its own node.
+         */
+        void SetLatticeOffset( int x, int y, int z )
+        {
+            mLatticeOffset[0] = x;
+            mLatticeOffset[1] = y;
+            mLatticeOffset[2] = z;
+        }
+
+    protected:
+        int mLatticeOffset[3] = { 0, 0, 0 };
     };
 
 #ifdef FASTNOISE_METADATA
diff --git a/include/FastNoise/Generators/Perlin.inl b/include/FastNoise/Generators/Perlin.inl
index 64917e2..00c36e9 100644
--- a/include/FastNoise/Generators/Perlin.inl
+++ b/include/FastNoise/Generators/Perlin.inl
@@ -43,9 +43,9 @@ class FastSIMD::DispatchClass<Perlin, SIMD> final : public virtual Perlin, publi
         float32v ys = FS::Floor( y );
         float32v zs = FS::Floor( z );
 
-        int32v x0 = FS::Convert<int32_t>( xs ) * int32v( Primes::X );
-        int32v y0 = FS::Convert<int32_t>( ys ) * int32v( Primes::Y );
-        int32v z0 = FS::Convert<int32_t>( zs ) * int32v( Primes::Z );
+        int32v x0 = ( FS::Convert<int32_t>( xs ) + int32v( mLatticeOffset[0] ) ) * int32v( Primes::X );
+        int32v y0 = ( FS::Convert<int32_t>( ys ) + int32v( mLatticeOffset[1] ) ) * int32v( Primes::Y );
+        int32v z0 = ( FS::Convert<int32_t>( zs ) + int32v( mLatticeOffset[2] ) ) * int32v( Primes::Z );
         int32v x1 = x0 + int32v( Primes::X );
         int32v y1 = y0 + int32v( Primes::Y );
         int32v z1 = z0 + int32v( Primes::Z );
